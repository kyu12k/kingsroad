rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 랭킹 데이터: 모두 읽기 가능. 쓰기는 "로그인 필요 + 재화/보상 필드는 서버(CF)만" 으로 제한.
    // (game.js는 점수·닉네임·알림·친구 필드만 직접 쓰고, 재화/장비/길드 필드는 Cloud Function만 씀.
    //  Cloud Function은 admin 권한이라 아래 규칙을 우회하므로 정상 동작한다.)
    match /leaderboard/{userId} {
      allow read: if true;

      // 클라이언트가 절대 직접 쓰면 안 되는 서버 전용 필드
      // (재화·장비·길드·보상 + 점수. 점수는 submitScoreSecure CF로만 기록)
      function serverOnlyKeys() {
        return ['dragonScales', 'dragonHornFragments', 'dragonHeadSkins',
                'personalEquipment', 'pendingRaidReward', 'pendingInvites',
                'guildId', 'guildDonateInfo', 'lastGuildAttend',
                'score', 'myMonthlyScore', 'totalScore', 'yearlyScore',
                'prevWeekScore', 'prevMonthlyScore'];
      }

      // 친구 기능은 '상대방 문서에 직접 쓰는' 구조라(신청·수락·응원·삭제)
      // 남의 쓰기를 전면 금지할 수 없다. 대신 남이 건드릴 수 있는 범위를 이 넷으로 못박는다.
      //  - pendingReceived : 친구 신청 보내기 (상대 문서)
      //  - pendingSent     : 수락 시 신청자 문서의 보낸 목록 정리
      //  - friends         : 수락·삭제·차단 시 양쪽 목록
      //  - pendingCheers   : 응원 보내기
      // 나머지(nickname·tribe·sessionToken·fcmToken·notificationTimes·maxHearts·
      //        weeklyHistory·blocked·lastCheerSent 등)는 전부 본인만 쓸 수 있다.
      function friendWritableKeys() {
        return ['friends', 'pendingReceived', 'pendingSent', 'pendingCheers'];
      }

      // 문서 ID는 uid가 아니라 태그('8648')라 request.auth.uid와 직접 비교할 수 없다.
      // uid → 태그의 유일한 권위 매핑은 saves/{uid}.tag 이고,
      // 서버(kingsroad/index.js verifyTag)도 이미 같은 근거로 판단한다.
      // saves/{uid}는 saveGameDataSecure CF만 쓸 수 있으므로(아래 saves 규칙) 위조 불가.
      function saveDoc() {
        return get(/databases/$(database)/documents/saves/$(request.auth.uid));
      }
      function isOwner() {
        return request.auth != null
               && saveDoc() != null
               && 'tag' in saveDoc().data
               && string(saveDoc().data.tag) == userId;
      }

      function affectedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // 생성: 본인 문서만. + 재화/보상 필드를 포함하지 않아야 함
      allow create: if request.auth != null
                    && isOwner()
                    && !request.resource.data.keys().hasAny(serverOnlyKeys())
                    && !('pendingReward' in request.resource.data);

      // 수정: 재화 필드 금지 +
      //       주간 보상(pendingReward)은 '삭제(수령)'만 허용하고 새로 만들거나 값 변경은 금지 +
      //       본인이 아니면 친구 관련 4개 필드 외에는 아무것도 못 건드림
      allow update: if request.auth != null
                    && !affectedKeys().hasAny(serverOnlyKeys())
                    && (
                         !affectedKeys().hasAny(['pendingReward'])
                         || !('pendingReward' in request.resource.data)
                       )
                    && (
                         isOwner()
                         || affectedKeys().hasOnly(friendWritableKeys())
                       );

      // 문서 통째 삭제 금지 (남의 데이터 삭제/그리핑 방지). 필요한 삭제는 CF가 처리.
      allow delete: if false;
    }

    // 명예의 전당: 읽기만 가능 (Cloud Functions에서만 쓰기)
    match /history/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 시스템 메타데이터: 읽기만 가능 (Cloud Functions에서만 쓰기)
    match /system_meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 캐시 데이터: 모두 읽기 가능, 로그인한 유저만 쓰기
    match /system_cache/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 랭킹 스냅샷: 읽기만 가능 (Cloud Functions에서만 쓰기)
    match /ranking_snapshots/{docId}/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // 길드: 인증된 유저만 읽기, 쓰기는 Cloud Functions에서만
    match /guilds/{guildId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 게임 세이브: 본인 문서만 읽기 허용, 쓰기는 saveGameDataSecure CF만
    match /saves/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
